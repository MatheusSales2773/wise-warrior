PORT=3000
CORS_ORIGIN=http://localhost:8081

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=wise
DB_PASSWORD=change-me
DB_DATABASE=wise

# Em produção: ao menos 32 caracteres aleatórios (ex.: `openssl rand -hex 32`); o boot recusa valores com change-me.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5
# ADR-007: o MVP libera itens premium para todos; defina false para exigir plan_tier premium.
COSMETICS_PREMIUM_FOR_ALL=true

# Atrás do nginx: número de proxies à frente do backend (ex.: 1), para o rate limiting usar o IP do cliente.
TRUST_PROXY=
# Rate limiting (#13). Contador em memória, por rota; vazio usa o padrão.
# Login e cadastro, por IP (padrão 10 a cada 60 s).
RATE_LIMIT_CREDENTIALS_LIMIT=
RATE_LIMIT_CREDENTIALS_TTL_SECONDS=
# Renovação de Session, por IP (padrão 30 a cada 60 s).
RATE_LIMIT_REFRESH_LIMIT=
RATE_LIMIT_REFRESH_TTL_SECONDS=
# Mutações de Study Session, por usuário (padrão 60 a cada 60 s).
RATE_LIMIT_STUDY_SESSION_LIMIT=
RATE_LIMIT_STUDY_SESSION_TTL_SECONDS=

# Economia de XP e antifraude (ADR-011). Vazio usa o padrão.
# XP por minuto completo de foco válido (padrão 10).
XP_PER_MINUTE=
# Limite contínuo por sessão e limite diário de foco, em horas; acima deles o foco é truncado (padrão 4 e 16).
ANTIFRAUDE_MAX_CONTINUOUS_HOURS=
ANTIFRAUDE_MAX_DAILY_HOURS=
