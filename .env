# Shared defaults for the local Docker Compose stack.
# Production overrides belong in .env.production, which is not versioned.
NODE_ENV=development

MYSQL_PORT=3306
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=wise
DB_DATABASE=wise

BACKEND_PORT=3000
FRONTEND_PORT=8081
CORS_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5

# Economia de Moedas (ADR-012): 1 Moeda a cada N minutos completos de foco válido (padrão 2).
COINS_PER_FOCUS_MINUTES_DIVISOR=2
