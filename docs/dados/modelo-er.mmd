        varchar id PK
        varchar raid_id FK
        varchar user_id FK
        varchar study_session_id FK,UK
        int xp_contributed
        datetime created_at
    }
    raid_participations {
        varchar id PK
        varchar raid_id FK
        varchar user_id FK
        datetime created_at
    }
    raids {
        varchar id PK
        varchar guild_id FK
        varchar mission_id FK
        int goal_xp
        int progress_xp
        datetime starts_at
        datetime ends_at
        varchar status
        datetime goal_reached_at
        int regenerated_xp
        varchar fury_through
        datetime opened_at
        varchar mission_owner_user_id
    }
