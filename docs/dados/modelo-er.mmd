    active_study_sessions {
        varchar user_id PK,FK
        varchar study_session_id FK,UK
    }
    characters {
        varchar id PK
        varchar user_id FK,UK
        int level
        bigint xp_total
        varchar companion_id
    }
    coin_balances {
        varchar user_id PK,FK
        int balance
        datetime updated_at
    }
    coin_ledger_entries {
        varchar id PK
        varchar user_id FK
        int amount
        int balance_after
        enum origin_type
        varchar origin_ref
        datetime created_at
    }
    cosmetic_items {
        varchar id PK
        varchar category
        varchar name
        varchar unlock_condition
        tinyint requires_premium
        int price
        tinyint for_sale
    }
    guild_chat_messages {
        varchar id PK
        varchar guild_id FK
        varchar user_id FK
        text body
        datetime sent_at
        bigint seq UK
        varchar kind
        varchar contribution_id FK,UK
        int xp
    }
    guild_memberships {
        varchar id PK
        varchar guild_id FK
        varchar user_id FK,UK
        varchar role
        datetime joined_at
    }
    guild_mission_choices {
        varchar guild_id PK,FK
        varchar mission_id FK
        varchar owner_user_id FK
        datetime chosen_at
    }
    guilds {
        varchar id PK
        varchar name UK
        int level
        varchar created_by FK
        datetime created_at
    }
    mission_reward_items {
        varchar mission_id PK,FK
        varchar cosmetic_item_id PK,FK
    }
    missions {
        varchar id PK
        varchar slug UK
        varchar name
        varchar description
        varchar image_url
        int rotation_order UK
        int price
    }
    pack_payments {
        varchar id PK
        varchar user_id FK
        varchar pack_id FK
        varchar stripe_checkout_session_id UK
        int amount_cents
        char currency
        datetime paid_at
    }
    packs {
        varchar id PK
        varchar slug UK
        varchar name
        varchar description
        int price_cents
        char currency
        tinyint for_sale
        datetime created_at
    }
